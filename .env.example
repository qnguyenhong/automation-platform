# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/automation_platform?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY=24h

# Worker
WORKER_SERVER_URL=http://localhost:8080
WORKER_NAME=worker-1
WORKER_EXECUTOR_TYPES=api,e2e,load,unit
WORKER_MAX_CONCURRENT=4
WORKER_POLL_INTERVAL=2s
WORKER_HEARTBEAT_INTERVAL=10s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws
